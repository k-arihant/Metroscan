# =================================================================
# METROSCAN LEGAL METROLOGY VERIFICATION PLATFORM
# Environment Configuration Template
# -----------------------------------------------------------------
# Copy this file to .env or backend/.env and replace placeholder
# values with your actual service credentials.
# NEVER commit .env files containing real secrets to version control.
# =================================================================

# ── 1. Pipeline Execution Mode ──────────────────────────────────
# Set to 'false' to run live PaddleOCR + Gemini semantic extraction.
# Set to 'true' to return simulated statutory evaluation responses.
USE_MOCK=false

# ── 2. Google Gemini Developer API (Stage 4 Extraction) ─────────
# Obtain free/developer key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── 3. Supabase Cloud Database (PostgreSQL + Auth) ──────────────
# Obtain from Project Settings -> API: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# ── 4. Cloudinary Cloud Storage (Dossier & Image Hosting) ───────
# Obtain from Cloudinary Console Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 5. SMTP Email Dispatch (Official Legal Notices & Alerts) ────
# Standard SMTP configuration (e.g. Gmail App Password or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.gov.in
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_email@example.gov.in
SMTP_FROM_NAME=MetroScan Legal Metrology Enforcement Portal

# ── 6. Application Security & Constraints ───────────────────────
# Secret key for signing and verifying JWT tokens
JWT_SECRET_KEY=your_long_random_jwt_secret_key_minimum_32_characters
# Maximum allowed upload size per image in megabytes
MAX_IMAGE_SIZE_MB=15
