# =================================================================
# METROSCAN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------
# Copy this file to .env or backend/.env and replace placeholder
# values with your actual service credentials.
# NEVER commit .env files containing real secrets to version control.
# =================================================================

USE_MOCK=false

GEMINI_API_KEY=your_gemini_api_key_here

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.gov.in
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_email@example.gov.in
SMTP_FROM_NAME=MetroScan Legal Metrology Enforcement Portal

JWT_SECRET_KEY=your_long_random_jwt_secret_key_minimum_32_characters
MAX_IMAGE_SIZE_MB=15
